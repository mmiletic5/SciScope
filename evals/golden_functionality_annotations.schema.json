{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciscope.example/schemas/golden_functionality_annotations.v1.schema.json",
  "title": "SciScope Golden Functionality Annotations v1",
  "description": "Person 2 sidecar; separate from the unchanged shared Golden question schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "corpus_version",
    "annotations"
  ],
  "properties": {
    "schema_version": {
      "const": "golden-functionality-v1"
    },
    "dataset_version": {
      "const": "golden-v1"
    },
    "corpus_version": {
      "const": "pilot17-xml-1fff1573b610"
    },
    "annotations": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/annotation"
      }
    }
  },
  "$defs": {
    "functionality": {
      "type": "string",
      "enum": [
        "research_question_explorer",
        "evidence_comparison",
        "conflicting_evidence_finder",
        "research_gap_hypothesis_assistant"
      ]
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "slot",
        "partition",
        "primary_functionality",
        "functionalities",
        "answerability",
        "evidence_references",
        "expected_output"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "slot": {
          "type": "string",
          "enum": [
            "Q1",
            "Q2",
            "Q3",
            "Q4",
            "Q5",
            "Q6",
            "Q7",
            "Q8",
            "Q9"
          ]
        },
        "partition": {
          "type": "string",
          "enum": [
            "development",
            "held_out"
          ]
        },
        "primary_functionality": {
          "$ref": "#/$defs/functionality"
        },
        "functionalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/functionality"
          }
        },
        "answerability": {
          "type": "string",
          "enum": [
            "answerable",
            "insufficient_evidence"
          ]
        },
        "evidence_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_reference"
          }
        },
        "expected_output": {
          "$ref": "#/$defs/expected_output"
        }
      }
    },
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_reference_id",
        "doi",
        "section",
        "chunk_id",
        "source_locator",
        "source_xml_sha256",
        "source_url",
        "source_passage",
        "quotation",
        "relevance_label",
        "relevance_rationale",
        "claim_ids",
        "role"
      ],
      "properties": {
        "evidence_reference_id": {
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "source_xml_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "source_passage": {
          "type": "string",
          "minLength": 25
        },
        "quotation": {
          "type": "string",
          "minLength": 1
        },
        "relevance_label": {
          "type": "string",
          "enum": [
            "0",
            "1",
            "2",
            "3"
          ]
        },
        "relevance_rationale": {
          "type": "string",
          "minLength": 1
        },
        "claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "role": {
          "type": "string",
          "enum": [
            "supports",
            "contrasts",
            "context",
            "insufficiency_check"
          ]
        }
      }
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim_evidence_links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_id",
              "evidence_reference_ids"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "evidence_reference_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "expected_disposition": {
          "type": "string",
          "enum": [
            "answer",
            "qualify",
            "abstain"
          ]
        },
        "paper_comparisons": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "conflicting_findings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "contrasted_findings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "conflict_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "finding_relationship",
            "decision",
            "negative_control",
            "rationale",
            "evidence_reference_ids"
          ],
          "properties": {
            "finding_relationship": {
              "type": "string",
              "enum": [
                "genuine_conflict",
                "apparent_contrast",
                "non_equivalent",
                "insufficiently_comparable"
              ]
            },
            "decision": {
              "type": "string",
              "enum": [
                "report_conflict",
                "do_not_report_conflict"
              ]
            },
            "negative_control": {
              "type": "boolean"
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_reference_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "methodological_explanations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "gap_statement": {
          "type": "string",
          "minLength": 1
        },
        "gap_scope": {
          "type": "string",
          "minLength": 1
        },
        "supporting_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidate_research_question": {
          "type": "string",
          "minLength": 1
        },
        "candidate_hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_needed_to_test": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minProperties": 1
    }
  }
}
