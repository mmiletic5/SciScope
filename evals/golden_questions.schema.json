{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciscope.example/schemas/golden_questions.schema.json",
  "title": "SciScope Golden Evaluation Questions",
  "description": "Format for a versioned, manually curated scientific retrieval evaluation dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_version",
    "corpus_version",
    "questions"
  ],
  "properties": {
    "dataset_version": {
      "type": "string",
      "minLength": 1,
      "description": "Version identifier for this dataset revision."
    },
    "corpus_version": {
      "type": "string",
      "minLength": 1,
      "description": "Version identifier for the source corpus used to curate this dataset."
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "change_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "reviewer",
          "reason"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "question_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Optional audit trail for dataset corrections or curation changes."
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "question",
        "query_language",
        "expected_findings",
        "relevant_papers",
        "reviewer",
        "verification_status",
        "source_corpus_version"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "query_language": {
          "type": "string",
          "minLength": 2,
          "description": "Language tag or documented language name."
        },
        "expected_findings": {
          "type": "string",
          "minLength": 1,
          "description": "Reference answer derived from inspected source material."
        },
        "relevant_papers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relevantPaper"
          }
        },
        "expected_insufficient_evidence": {
          "type": "boolean",
          "description": "Whether the expected outcome is that the corpus lacks sufficient evidence."
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "description": "Human reviewer identifier or role as recorded by the team."
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "unverified",
            "in_review",
            "verified"
          ]
        },
        "verified_date": {
          "type": "string",
          "format": "date"
        },
        "source_corpus_version": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expected_insufficient_evidence": {
                "const": true
              }
            },
            "required": [
              "expected_insufficient_evidence"
            ]
          },
          "else": {
            "properties": {
              "relevant_papers": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "verified"
              }
            },
            "required": [
              "verification_status"
            ]
          },
          "then": {
            "required": [
              "verified_date"
            ]
          }
        }
      ]
    },
    "relevantPaper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doi",
        "sections",
        "evidence"
      ],
      "properties": {
        "doi": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/\\S+$",
          "description": "DOI of an inspected source paper; do not use fabricated identifiers."
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relevance_label"
      ],
      "properties": {
        "relevance_label": {
          "type": "string",
          "minLength": 1,
          "description": "Team-defined relevance judgment; document its label rubric with the dataset."
        },
        "quotation": {
          "type": "string",
          "minLength": 1,
          "description": "Optional short supporting quotation copied from the inspected source."
        },
        "source_locator": {
          "type": "string",
          "minLength": 1,
          "description": "Durable locator such as section path, paragraph number, table, or XML path."
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1,
          "description": "Optional derived identifier; do not use as the only ground-truth locator."
        }
      },
      "anyOf": [
        {
          "required": [
            "quotation"
          ]
        },
        {
          "required": [
            "source_locator"
          ]
        }
      ]
    }
  }
}
