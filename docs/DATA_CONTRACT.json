{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciscope.example/schemas/data_contract.json",
  "title": "SciScope flat F001–F003 record shapes — draft contract v0.3",
  "description": "Flat F001–F003 record shapes with delivery_manifest at the root. Draft until Person 2 approves the contract PR. Integers are written as integer literals, never 1.0; runtime rejects integral floats although JSON Schema integer accepts them. Byte integrity, normalized identities and cross-record semantics are validated separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "status",
    "counts",
    "files",
    "processing_versions",
    "source_reports",
    "embedding_set"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.3.0"
    },
    "contract_version": {
      "type": "string",
      "const": "0.3.0"
    },
    "status": {
      "type": "string",
      "const": "draft"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "papers",
        "sections",
        "chunks"
      ],
      "properties": {
        "papers": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 0
        },
        "sections": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 0
        },
        "chunks": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 0
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "papers.jsonl",
        "sections.jsonl",
        "chunks.jsonl",
        "vectors.f32",
        "embedding_manifest.json"
      ],
      "properties": {
        "papers.jsonl": {
          "$ref": "#/$defs/file_descriptor"
        },
        "sections.jsonl": {
          "$ref": "#/$defs/file_descriptor"
        },
        "chunks.jsonl": {
          "$ref": "#/$defs/file_descriptor"
        },
        "vectors.f32": {
          "$ref": "#/$defs/file_descriptor"
        },
        "embedding_manifest.json": {
          "$ref": "#/$defs/file_descriptor"
        }
      }
    },
    "processing_versions": {
      "$ref": "#/$defs/processing_versions"
    },
    "source_reports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parse_report.json",
        "chunk_report.json",
        "embedding_report.json"
      ],
      "properties": {
        "parse_report.json": {
          "$ref": "#/$defs/source_report_descriptor"
        },
        "chunk_report.json": {
          "$ref": "#/$defs/source_report_descriptor"
        },
        "embedding_report.json": {
          "$ref": "#/$defs/source_report_descriptor"
        }
      }
    },
    "embedding_set": {
      "$ref": "#/$defs/embedding_set"
    }
  },
  "$defs": {
    "paper": {
      "type": "object",
      "description": "Flat paper; publication_year is the only derived metadata field.",
      "additionalProperties": false,
      "required": [
        "doi",
        "title",
        "authors",
        "journal",
        "publication_date",
        "article_type",
        "subjects",
        "license",
        "language",
        "source_url",
        "retrieved_at",
        "xml_sha256",
        "publication_year"
      ],
      "properties": {
        "doi": {
          "type": "string",
          "description": "F001 normalization: sciscope.plos_pilot.doi.normalize_doi (approved prefixes, trimming/punctuation and lowercase); normalization consistency is semantic. Local XML: data/raw/plos/ + quote(doi, safe='') + .xml.",
          "pattern": "^10\\.[0-9]{4,9}/\\S+(?![\\s\\S])$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "surname",
              "given_names"
            ],
            "properties": {
              "surname": {
                "type": "string",
                "minLength": 1
              },
              "given_names": {
                "type": "string"
              }
            }
          },
          "minItems": 1
        },
        "journal": {
          "type": "string",
          "minLength": 1
        },
        "publication_date": {
          "type": "string",
          "description": "ASCII year/year-month/full-date shape; calendar checked by builder.",
          "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?(?![\\s\\S])$"
        },
        "article_type": {
          "type": "string",
          "minLength": 1
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "license": {
          "type": "string",
          "description": "Raw license string; no normalization.",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "description": "Raw language; EN and en both occur. Compare case-insensitively.",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?\\+00:00(?![\\s\\S])$"
        },
        "xml_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
        },
        "publication_year": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 1
        }
      }
    },
    "section": {
      "type": "object",
      "description": "Flat F002 section; paragraph_count counts own direct p, including empty.",
      "additionalProperties": false,
      "required": [
        "doi",
        "title",
        "xml_sha256",
        "section_id",
        "parent_section_id",
        "section_path",
        "original_heading",
        "normalized_type",
        "source_locator",
        "depth",
        "paragraph_count"
      ],
      "properties": {
        "doi": {
          "type": "string",
          "description": "F001 normalization: sciscope.plos_pilot.doi.normalize_doi (approved prefixes, trimming/punctuation and lowercase); normalization consistency is semantic. Local XML: data/raw/plos/ + quote(doi, safe='') + .xml.",
          "pattern": "^10\\.[0-9]{4,9}/\\S+(?![\\s\\S])$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "xml_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
        },
        "section_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_section_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "section_path": {
          "type": "array",
          "description": "Ordered headings; (untitled) means no heading, never display it.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "original_heading": {
          "type": "string"
        },
        "normalized_type": {
          "type": "string",
          "description": "Taxonomy v0: abstracts always abstract; body precedence is exact normalized heading > sec-type > nearest explicit ancestor > other. Mappings and heading normalization are in sciscope.jats.classify.",
          "enum": [
            "abstract",
            "introduction",
            "methods",
            "results",
            "results_discussion",
            "discussion",
            "conclusions",
            "other"
          ]
        },
        "source_locator": {
          "type": "string",
          "description": "Locator v1: jats:v1:<64 lowercase hex> followed by /name[index] components; Unicode name grammar [^\\W\\d][\\w\\.-]*, positive indices without leading zeros. locator_digest alone does not validate the path; root/traversal depend on the source document.",
          "pattern": "^jats:v1:[0-9a-f]{64}:(?:/[^\\W\\d][\\w\\.-]*\\[[1-9][0-9]*\\])+(?![\\s\\S])$"
        },
        "depth": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 1
        },
        "paragraph_count": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 0
        }
      }
    },
    "chunk": {
      "type": "object",
      "description": "Flat F003 chunk; hashes and source consistency are checked semantically.",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "doi",
        "xml_sha256",
        "section_id",
        "ordinal",
        "chunk_kind",
        "normalized_type",
        "section_path",
        "text",
        "text_sha256",
        "spans",
        "source_locator",
        "content_tokens",
        "hard_split",
        "omitted",
        "chunking_version",
        "token_counter_id",
        "template_version"
      ],
      "properties": {
        "chunk_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
        },
        "doi": {
          "type": "string",
          "description": "F001 normalization: sciscope.plos_pilot.doi.normalize_doi (approved prefixes, trimming/punctuation and lowercase); normalization consistency is semantic. Local XML: data/raw/plos/ + quote(doi, safe='') + .xml.",
          "pattern": "^10\\.[0-9]{4,9}/\\S+(?![\\s\\S])$"
        },
        "xml_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
        },
        "section_id": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 1
        },
        "chunk_kind": {
          "type": "string",
          "const": "paragraph"
        },
        "normalized_type": {
          "type": "string",
          "description": "Taxonomy v0: abstracts always abstract; body precedence is exact normalized heading > sec-type > nearest explicit ancestor > other. Mappings and heading normalization are in sciscope.jats.classify.",
          "enum": [
            "abstract",
            "introduction",
            "methods",
            "results",
            "results_discussion",
            "discussion",
            "conclusions",
            "other"
          ]
        },
        "section_path": {
          "type": "array",
          "description": "Ordered headings; (untitled) means no heading, never display it.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          },
          "minItems": 1
        },
        "source_locator": {
          "type": "string",
          "description": "Locator v1: jats:v1:<64 lowercase hex> followed by /name[index] components; Unicode name grammar [^\\W\\d][\\w\\.-]*, positive indices without leading zeros. locator_digest alone does not validate the path; root/traversal depend on the source document.",
          "pattern": "^jats:v1:[0-9a-f]{64}:(?:/[^\\W\\d][\\w\\.-]*\\[[1-9][0-9]*\\])+(?![\\s\\S])$"
        },
        "content_tokens": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 1
        },
        "hard_split": {
          "type": "boolean"
        },
        "omitted": {
          "type": "array",
          "description": "Raw omitted XML element names, not count objects.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "chunking_version": {
          "type": "string",
          "const": "chunking-v1"
        },
        "token_counter_id": {
          "type": "string",
          "const": "utf8-bytes-div3-v1"
        },
        "template_version": {
          "type": "string",
          "const": "embedding-text-v1"
        }
      }
    },
    "span": {
      "type": "object",
      "description": "Half-open Unicode code-point offsets; end > start is semantic (T005).",
      "additionalProperties": false,
      "required": [
        "source_locator",
        "paragraph_index",
        "start",
        "end"
      ],
      "properties": {
        "source_locator": {
          "type": "string",
          "description": "Locator v1: jats:v1:<64 lowercase hex> followed by /name[index] components; Unicode name grammar [^\\W\\d][\\w\\.-]*, positive indices without leading zeros. locator_digest alone does not validate the path; root/traversal depend on the source document.",
          "pattern": "^jats:v1:[0-9a-f]{64}:(?:/[^\\W\\d][\\w\\.-]*\\[[1-9][0-9]*\\])+(?![\\s\\S])$"
        },
        "paragraph_index": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 1
        },
        "start": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 1
        }
      }
    },
    "embedding_set": {
      "type": "object",
      "description": "Queries must use the same provider, model, dimensions and query_prefix.",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "dimensions",
        "dtype",
        "row_mapping",
        "passage_prefix",
        "query_prefix",
        "normalization",
        "chunks_sha256",
        "vectors_sha256",
        "embedding_model_revision"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 1
        },
        "dtype": {
          "type": "string",
          "const": "float32-le"
        },
        "row_mapping": {
          "type": "string",
          "description": "Vector row i belongs ONLY to embedding_manifest.entries[i].chunk_id; never use position in chunks.jsonl.",
          "const": "embedding_manifest.entries"
        },
        "passage_prefix": {
          "type": "string"
        },
        "query_prefix": {
          "type": "string"
        },
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "declared",
            "observed_norm_min",
            "observed_norm_max",
            "tolerance"
          ],
          "properties": {
            "declared": {
              "type": "string",
              "const": "l2"
            },
            "observed_norm_min": {
              "type": "number"
            },
            "observed_norm_max": {
              "type": "number"
            },
            "tolerance": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        },
        "chunks_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
        },
        "vectors_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
        },
        "embedding_model_revision": {
          "type": [
            "string",
            "null"
          ],
          "description": "Null when not applicable; never invent a revision.",
          "minLength": 1
        }
      }
    },
    "embedding_manifest": {
      "type": "object",
      "description": "Unchanged F003 manifest shape; delivery rejects partial sets separately.",
      "additionalProperties": false,
      "required": [
        "format_version",
        "status",
        "provider",
        "model",
        "requested_dimensions",
        "returned_dimensions",
        "normalization",
        "passage_prefix",
        "query_prefix",
        "template_version",
        "token_counter_id",
        "chunking_version",
        "chunks_sha256",
        "chunk_count",
        "vector_count",
        "creation_date",
        "usage",
        "estimated_input_tokens",
        "provider_input_count",
        "custom_base_url_used",
        "vectors_file",
        "vectors_dtype",
        "vectors_sha256",
        "entries"
      ],
      "properties": {
        "format_version": {
          "type": "string",
          "const": "embedding-set-v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "requested_dimensions": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 1
        },
        "returned_dimensions": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 1
        },
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "declared",
            "observed_norm_min",
            "observed_norm_max"
          ],
          "properties": {
            "declared": {
              "type": "string",
              "const": "l2"
            },
            "observed_norm_min": {
              "type": "number"
            },
            "observed_norm_max": {
              "type": "number"
            }
          }
        },
        "passage_prefix": {
          "type": "string"
        },
        "query_prefix": {
          "type": "string"
        },
        "template_version": {
          "type": "string",
          "const": "embedding-text-v1"
        },
        "token_counter_id": {
          "type": "string",
          "const": "utf8-bytes-div3-v1"
        },
        "chunking_version": {
          "type": "string",
          "const": "chunking-v1"
        },
        "chunks_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
        },
        "chunk_count": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 0
        },
        "vector_count": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 0
        },
        "creation_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])$"
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt_tokens",
            "total_tokens"
          ],
          "properties": {
            "prompt_tokens": {
              "type": "integer",
              "description": "Written as integer literals, never 1.0.",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "description": "Written as integer literals, never 1.0.",
              "minimum": 0
            }
          }
        },
        "estimated_input_tokens": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 0
        },
        "provider_input_count": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 0
        },
        "custom_base_url_used": {
          "type": "boolean"
        },
        "vectors_file": {
          "type": "string",
          "const": "vectors.f32"
        },
        "vectors_dtype": {
          "type": "string",
          "const": "float32-le"
        },
        "vectors_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chunk_id",
              "input_sha256"
            ],
            "properties": {
              "chunk_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
              },
              "input_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
              }
            }
          }
        }
      }
    },
    "file_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes",
        "record_count"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
        },
        "bytes": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 0
        },
        "record_count": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 0
        }
      }
    },
    "source_report_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
        },
        "bytes": {
          "type": "integer",
          "description": "Written as integer literals, never 1.0.",
          "minimum": 0
        }
      }
    },
    "processing_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parser",
        "taxonomy",
        "locator",
        "chunking_version",
        "token_counter_id",
        "template_version"
      ],
      "properties": {
        "parser": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "source_sha256"
          ],
          "properties": {
            "version": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "source_sha256": {
              "type": "string",
              "description": "Informational source_sha256; never compare with local source files.",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
            }
          }
        },
        "taxonomy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "source_sha256"
          ],
          "properties": {
            "version": {
              "type": "string",
              "const": "v0"
            },
            "source_sha256": {
              "type": "string",
              "description": "Informational source_sha256; never compare with local source files.",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
            }
          }
        },
        "locator": {
          "type": "string",
          "const": "jats:v1"
        },
        "chunking_version": {
          "type": "string",
          "const": "chunking-v1"
        },
        "token_counter_id": {
          "type": "string",
          "const": "utf8-bytes-div3-v1"
        },
        "template_version": {
          "type": "string",
          "const": "embedding-text-v1"
        }
      }
    }
  }
}
